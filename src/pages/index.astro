---
import { Font, Image } from "astro:assets";
import seal from "../assets/seal.png";
import Blocks from "../components/Blocks.astro";
import Sheet from "../components/Sheet.astro";
import articles from "../data/articles.json";
import games from "../data/games.json";
import { fileNo, home, shelves } from "../lib/desk.ts";
import type { Block } from "../lib/readme.ts";
import "../styles/desk.css";

const all = shelves();
const boards = games as Record<string, Block[]>;
const guestRows = boards.guestbook?.find((b) => b.kind === "table")?.rows ?? [];
const minutes = articles.reduce((n, a) => n + a.readingMinutes, 0);
const shortDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
const description = "Raw outputs, researches, and unpolished tools. Everything here is v0.";
const count = all.reduce((n, s) => n + s.repos.length, 0);
---

<!doctype html>
<html lang="en" class="list">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>0-draft</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="0-draft" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f0e0d" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <svg width="0" height="0" class="sprite" aria-hidden="true">
      <symbol id="stamp" viewBox="0 0 172 76">
        <rect x="3" y="3" width="166" height="70" rx="5" fill="none" stroke="currentColor" stroke-width="4.5"></rect>
        <rect x="10" y="10" width="152" height="56" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"></rect>
        <text x="86" y="44" text-anchor="middle" font-size="31" font-weight="900" letter-spacing="5" fill="currentColor">PROOF</text>
        <text x="86" y="59" text-anchor="middle" font-size="9" font-weight="700" letter-spacing="1.6" fill="currentColor">v0 · not for release</text>
      </symbol>
    </svg>
    <a class="skip" href="#list" data-mode="list">Skip to the project list</a>

    <header class="hud hud-top">
      <a class="brand" href="/" aria-label="0-draft, back to the start">
        <Image src={seal} alt="" width={40} densities={[1, 2]} format="webp" />
        <span>0-draft</span>
      </a>
      <div class="hud-links">
        <button type="button" class="pill" data-mode-toggle aria-pressed="false">List view</button>
        <a class="pill" href="https://github.com/0-draft">GitHub</a>
      </div>
    </header>

    <main class="desk" id="desk" aria-label="The 0-draft desk">
      <div class="surface" aria-hidden="true"></div>
      <div class="world" id="world">
        <section class="item home" id="home" data-x={home.x} data-y={home.y} data-tilt="0" data-group="home">
          <Image
            class="home-seal"
            src={seal}
            alt="The 0-draft seal: a robot face under a black beret with a red heart"
            width={520}
            densities={[1, 2]}
            format="webp"
            loading="eager"
            fetchpriority="high"
          />
          <div class="home-copy">
            <h1>0-draft</h1>
            <p class="lede">Raw outputs, researches, and unpolished tools. Everything here is v0.</p>
            <p class="hint">
              <span class="hint-desk">Drag the desk to look around and pinch to zoom. Break a seal and the project opens right here.</span>
              <span class="hint-list">{count} files on the desk right now, in {all.length} piles.</span>
            </p>
            <p class="password">
              Membership is open. The password is
              <button type="button" class="redacted" aria-pressed="false">
                <span>a GitHub account</span>
              </button>.
            </p>
          </div>
        </section>

        <div class="list-anchor" id="list" tabindex="-1"></div>

        {
          all.map((shelf, i) => (
            <section class="shelf" id={`shelf-${shelf.id}`} aria-labelledby={`label-${shelf.id}`} data-group={shelf.id}>
              <header
                class="item label"
                data-x={shelf.label.x}
                data-y={shelf.label.y}
                data-tilt="0"
                data-group={shelf.id}
              >
                <span class="file-no">{fileNo(i)}</span>
                <h2 id={`label-${shelf.id}`}>{shelf.title}</h2>
                <p>{shelf.blurb}</p>
              </header>
              <div class="pile">
                {shelf.repos.map((repo) =>
                  repo.name === "blackjack" || repo.name === "shogi" ? (
                    <Sheet repo={repo} group={shelf.id} kind="board">
                      <div class:list={["board", `board-${repo.name}`]} data-game={repo.name}>
                        <Blocks blocks={boards[repo.name] ?? []} />
                      </div>
                    </Sheet>
                  ) : repo.name === "guestbook" ? (
                    <Sheet repo={repo} group={shelf.id} kind="book">
                      <div class="book">
                        <ol class="book-lines" data-game="guestbook">
                          {guestRows.map(([date, who, msg]) => (
                            <li>
                              <time>{date?.[0]?.text}</time>
                              <a class="who" href={who?.[0]?.href}>
                                {who?.[0]?.text}
                              </a>
                              <a class="msg" href={msg?.[0]?.href}>
                                {msg?.[0]?.text}
                              </a>
                            </li>
                          ))}
                        </ol>
                        <a
                          class="btn btn-wax"
                          href="https://github.com/0-draft/guestbook/issues/new?template=guestbook.yml&title=%F0%9F%93%AE+%5BGuest+Book%5D"
                        >
                          Sign the guest book
                        </a>
                      </div>
                    </Sheet>
                  ) : repo.name === "dev.to" ? (
                    <Sheet repo={repo} group={shelf.id} kind="receipt">
                      <div class="receipt">
                        <p class="r-head">
                          <strong>dev.to/kanywst</strong>
                          <span>Latest {articles.length} articles</span>
                        </p>
                        <ol class="r-lines">
                          {articles.map((a) => (
                            <li>
                              <a href={a.url}>{a.title}</a>
                              <span class="r-min">{a.readingMinutes} min</span>
                              <span class="r-date">{shortDate(a.publishedAt)}</span>
                            </li>
                          ))}
                        </ol>
                        <p class="r-total">
                          <span>Total reading</span>
                          <span>{minutes} min</span>
                        </p>
                        <p class="r-thanks">Thanks for reading. Come back for v1.</p>
                      </div>
                    </Sheet>
                  ) : (
                    <Sheet repo={repo} group={shelf.id} />
                  ),
                )}
              </div>
            </section>
          ))
        }
      </div>
      <div class="scrim" aria-hidden="true"></div>
    </main>


    <nav class="hud tray" aria-label="Move around the desk">
      <div class="tray-go">
        <button type="button" data-go="home">Home</button>
        {all.map((s) => <button type="button" data-go={s.id}>{s.title}</button>)}
      </div>
      <div class="tray-zoom">
        <button type="button" data-zoom="out" aria-label="Zoom out">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10" /></svg>
        </button>
        <output class="zoom-read" aria-live="off">100%</output>
        <button type="button" data-zoom="in" aria-label="Zoom in">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M8 3v10" /></svg>
        </button>
      </div>
    </nav>

    <button type="button" class="hud minimap" aria-label="Show the whole desk">
      <svg aria-hidden="true"></svg>
    </button>

    <div class="live" hidden>
      <div class="live-bar">
        <strong class="live-title"></strong>
        <a class="pill live-open" href="/" target="_blank" rel="noopener">Open in a new tab</a>
        <button type="button" class="pill pill-wax live-close">Back to the desk</button>
      </div>
      <iframe class="live-frame" title="Live project"></iframe>
    </div>

    <script>
      import "../scripts/desk.ts";
      import "../scripts/boards.ts";
    </script>
  </body>
</html>
